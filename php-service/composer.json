{
    "name": "gorust/php-service",
    "description": "Padanan PHP dari go-service & rust-service",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "ext-apcu": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "App\\Tests\\": "tests/" }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
