# Salin menjadi .env untuk mengubah konfigurasi.

# Batas resource untuk SEMUA service bahasa (selalu sama, demi keadilan).
# Bilangan bulat. 1 = muat 6 service sekaligus di host 8 core; 2 = untuk duel 2 bahasa.
CPU_LIMIT=1
MEM_LIMIT=256m

# PHP: jumlah worker FPM (konkurensi) dan JIT (tracing | disable)
PHP_WORKERS=8
PHP_JIT=tracing

# Port di host
MONITOR_PORT=8080
GO_PORT=8081
RUST_PORT=8082
PHP_PORT=8083
NODE_PORT=8084
JAVA_PORT=8085
PYTHON_PORT=8086
